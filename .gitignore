# ---- Data -------------------------------------------------------------
# Raw downloads are large and publicly re-downloadable. Commit the code that
# fetches them (see docs/METHODS.md, Data), not the files themselves.
data/raw/*
data/processed/*
# ...but keep the empty folders present in the repo:
!data/raw/.gitkeep
!data/processed/.gitkeep

# ---- Python -----------------------------------------------------------
# Both forms: a trailing slash does not match a symlink, and .venv here is
# often a symlink to an interpreter kept outside the repository.
.venv
.venv/
venv
venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# ---- Models -----------------------------------------------------------
# Trained model artefacts can be regenerated; add exceptions later if the
# Streamlit dashboard needs a specific one committed.
*.joblib
*.pkl

# ---- macOS ------------------------------------------------------------
.DS_Store

# ---- Editors ----------------------------------------------------------
.vscode/
.idea/

# ---- R --------------------------------------------------------------
.Rhistory
.RData
.Rproj.user/

# ---- Test / build artefacts -----------------------------------------
.pytest_cache/
*.egg-info/
build/
dist/

# ---- Figures ---------------------------------------------------------
# Regenerated by the pipeline; keep the folder, not its contents.
figures/*
!figures/.gitkeep
