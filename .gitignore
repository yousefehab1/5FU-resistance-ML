# ---- Data / generated outputs ------------------------------------------
# Raw inputs are downloaded once (see README) and
# treated as read-only source of truth. Everything else here is
# regenerated by the stages/ scripts -- keep the directories (.gitkeep),
# ignore their contents.
data/raw/*
data/processed/*
models/*
figures/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!models/.gitkeep
!figures/.gitkeep

# ---- Python -----------------------------------------------------------
.venv
venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# ---- Models -----------------------------------------------------------
*.joblib
*.pkl

# ---- macOS ------------------------------------------------------------
.DS_Store

# ---- Editors ----------------------------------------------------------
.vscode/
.idea/
